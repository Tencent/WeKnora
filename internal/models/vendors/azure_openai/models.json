    {"name": "GPT-5 deployments (reasoning, no sampling parameters)", "match": "gpt-5*", "reasoning": true, "input": ["text", "image"], "compat": {"supports_temperature": false}, "thinking_levels": {"off": "none", "minimal": "low"}},
    {"id": "gpt-5", "name": "GPT-5 deployment (thinking cannot be disabled)", "reasoning": true, "input": ["text", "image"], "compat": {"supports_temperature": false}, "thinking_levels": {"off": null, "xhigh": "high", "max": "high"}, "source": "https://developers.openai.com/api/docs/models/gpt-5"},
    {"id": "gpt-5-mini", "name": "GPT-5 Mini deployment (thinking cannot be disabled)", "reasoning": true, "input": ["text", "image"], "compat": {"supports_temperature": false}, "thinking_levels": {"off": null, "xhigh": "high", "max": "high"}, "source": "https://developers.openai.com/api/docs/models/gpt-5-mini"},
    {"id": "gpt-5-nano", "name": "GPT-5 Nano deployment (thinking cannot be disabled)", "reasoning": true, "input": ["text", "image"], "compat": {"supports_temperature": false}, "thinking_levels": {"off": null, "xhigh": "high", "max": "high"}, "source": "https://developers.openai.com/api/docs/models/gpt-5-nano"},
    {"name": "o1 deployments (always-on reasoning)", "match": "o1*", "reasoning": true, "input": ["text", "image"], "compat": {"supports_temperature": false}, "thinking_levels": {"off": null, "minimal": "low", "xhigh": "high", "max": "high"}},
    {"name": "o3 deployments (always-on reasoning)", "match": "o3*", "reasoning": true, "input": ["text", "image"], "compat": {"supports_temperature": false}, "thinking_levels": {"off": null, "minimal": "low", "xhigh": "high", "max": "high"}},
    {"name": "o4 deployments (always-on reasoning)", "match": "o4*", "reasoning": true, "input": ["text", "image"], "compat": {"supports_temperature": false}, "thinking_levels": {"off": null, "minimal": "low", "xhigh": "high", "max": "high"}},
    {"name": "GPT-4o deployments", "match": "gpt-4o*", "reasoning": false, "input": ["text", "image"]},
    {"name": "GPT-4.1 deployments", "match": "gpt-4.1*", "reasoning": false, "input": ["text", "image"]},
