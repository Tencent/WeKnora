{
  "scenario": "weknoracloud_signed_chat",
  "behavior": [
    "weKnoraCloudProvider.ForceRawHTTP -\u003e raw HTTP path",
    "endpoint: baseURL + /api/v1/chat/completions",
    "Auth signs headers over body MD5 (X-APPID/X-API-Key/X-Request-ID/X-Timestamp/X-Nonce/X-Signature)",
    "signature headers normalized to placeholders in golden; HMAC recomputed and asserted in-test",
    "completion budget on max_completion_tokens (default wire field)"
  ],
  "requests": [
    {
      "path": "/api/v1/chat/completions",
      "headers": {
        "Content-Type": "application/json",
        "X-Api-Key": "secret-456",
        "X-Appid": "app-123",
        "X-Nonce": "\u003cnonce\u003e",
        "X-Request-Id": "\u003crequest-id\u003e",
        "X-Signature": "\u003chmac-md5\u003e",
        "X-Timestamp": "\u003cunix-seconds\u003e"
      },
      "body": {
        "max_completion_tokens": 128,
        "messages": [
          {
            "content": "Hi",
            "role": "user"
          }
        ],
        "model": "weknora-chat",
        "temperature": 0.7
      }
    }
  ],
  "response": {
    "id": "chatcmpl-1",
    "object": "chat.completion",
    "created": 1700000000,
    "model": "golden-model",
    "choices": [
      {
        "index": 0,
        "message": {
          "role": "assistant",
          "content": "Hello there"
        },
        "finish_reason": "stop"
      }
    ],
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 5,
      "total_tokens": 15
    }
  },
  "client": {
    "content": "Hello there",
    "finish_reason": "stop",
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 5,
      "total_tokens": 15,
      "cache_reported": false,
      "cache_status": "unsupported"
    }
  }
}
