{
  "scenario": "aliyun_qwen_thinking_pin",
  "behavior": [
    "qwenThinkingProvider.Matches(qwen3-max)",
    "enable_thinking always present; non-stream request pins false even when Thinking=true",
    "stream request with Thinking=nil still pins false (alwaysSend)",
    "QwenChatCompletionRequest wrapper forces raw HTTP"
  ],
  "requests": [
    {
      "path": "/chat/completions",
      "headers": {
        "Authorization": "Bearer test-key",
        "Content-Type": "application/json"
      },
      "body": {
        "enable_thinking": false,
        "max_completion_tokens": 64,
        "messages": [
          {
            "content": [
              {
                "cache_control": {
                  "type": "ephemeral"
                },
                "text": "你好",
                "type": "text"
              }
            ],
            "role": "user"
          }
        ],
        "model": "qwen3-max"
      }
    },
    {
      "path": "/chat/completions",
      "headers": {
        "Accept": "text/event-stream",
        "Authorization": "Bearer test-key",
        "Content-Type": "application/json"
      },
      "body": {
        "enable_thinking": false,
        "max_completion_tokens": 64,
        "messages": [
          {
            "content": [
              {
                "cache_control": {
                  "type": "ephemeral"
                },
                "text": "你好",
                "type": "text"
              }
            ],
            "role": "user"
          }
        ],
        "model": "qwen3-max",
        "stream": true,
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ],
  "sse_response": [
    "data: {\"id\":\"chatcmpl-qwen\",\"object\":\"chat.completion.chunk\",\"created\":1700000000,\"model\":\"golden-model\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"你好\"},\"finish_reason\":null}]}",
    "",
    "data: {\"id\":\"chatcmpl-qwen\",\"object\":\"chat.completion.chunk\",\"created\":1700000000,\"model\":\"golden-model\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"\",\"finish_reason\":\"stop\"},\"finish_reason\":null}]}",
    "",
    "data: [DONE]",
    ""
  ],
  "client": [
    {
      "id": "",
      "response_type": "answer",
      "content": "你好",
      "done": false
    },
    {
      "id": "",
      "response_type": "answer",
      "content": "",
      "done": true
    }
  ]
