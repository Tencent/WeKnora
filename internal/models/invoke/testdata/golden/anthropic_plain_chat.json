{
  "scenario": "anthropic_plain_chat",
  "behavior": [
    "x-api-key + anthropic-version headers; no Authorization",
    "endpoint: baseURL + /v1/messages",
    "system folded into top-level system string",
    "CacheRetention none -\u003e plain string system, no cache markers",
    "CompletionBudget on max_tokens"
  ],
  "requests": [
    {
      "path": "/v1/messages",
      "headers": {
        "Anthropic-Version": "2023-06-01",
        "Content-Type": "application/json",
        "X-Api-Key": "test-key"
      },
      "body": {
        "model": "claude-sonnet-4-5",
        "max_tokens": 200,
        "system": "You are helpful.",
        "messages": [
          {
            "role": "user",
            "content": "Hi"
          }
        ],
        "temperature": 0.7
      }
    }
  ],
  "response": {
    "id": "msg_1",
    "type": "message",
    "role": "assistant",
    "model": "golden-claude",
    "content": [
      {
        "type": "text",
        "text": "Hello there"
      }
    ],
    "stop_reason": "end_turn",
    "usage": {
      "input_tokens": 10,
      "output_tokens": 5
    }
  },
  "client": {
    "content": "Hello there",
    "finish_reason": "end_turn",
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 5,
      "total_tokens": 15,
      "cache_miss_tokens": 10,
      "cache_reported": false,
      "cache_status": "unreported"
    }
  }
}
