{
  "scenario": "moonshot_fixed_temp_chat",
  "behavior": [
    "moonshotProvider.Matches(kimi-k2.5)",
    "ShapeRequest pins temperature=1 and zeroes top_p/penalties",
    "completion budget on max_tokens (moonshot wire field)"
  ],
  "requests": [
    {
      "path": "/chat/completions",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer test-key",
        "Content-Type": "application/json"
      },
      "body": {
        "model": "kimi-k2.5",
        "messages": [
          {
            "role": "user",
            "content": "Hi"
          }
        ],
        "max_tokens": 128,
        "temperature": 1
      }
    }
  ],
  "response": {
    "id": "chatcmpl-1",
    "object": "chat.completion",
    "created": 1700000000,
    "model": "golden-model",
    "choices": [
      {
        "index": 0,
        "message": {
          "role": "assistant",
          "content": "Hello there"
        },
        "finish_reason": "stop"
      }
    ],
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 5,
      "total_tokens": 15
    }
  },
  "client": {
    "content": "Hello there",
    "finish_reason": "stop",
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 5,
      "total_tokens": 15,
      "cache_reported": false,
      "cache_status": "unsupported"
    }
  }
}
