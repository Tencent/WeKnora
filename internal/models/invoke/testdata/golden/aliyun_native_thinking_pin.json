{
  "scenario": "aliyun_native_thinking_pin",
  "behavior": [
    "native DashScope generation wire ({model, input, parameters} envelope, 2026-09-12 ruling)",
    "qwen3 family carries enable_thinking on every request; non-stream pins false even with Thinking=true",
    "stream pins false with Thinking=nil (alwaysSend) + X-DashScope-SSE header + incremental_output",
    "qwen3-max is on the documented explicit-cache list: the sole conversation message carries a cache_control:{type:ephemeral} breakpoint by default (2026-09-13 方案)",
    "no [DONE] sentinel — the final frame carries finish_reason + usage and closes the stream"
  ],
  "requests": [
    {
      "path": "/api/v1/services/aigc/text-generation/generation",
      "headers": {
        "Authorization": "Bearer test-key",
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "body": {
        "model": "qwen3-max",
        "input": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "你好",
                  "cache_control": { "type": "ephemeral" }
                }
              ]
            }
          ]
        },
        "parameters": {
          "result_format": "message",
          "max_completion_tokens": 64,
          "enable_thinking": false
        }
      }
    },
    {
      "path": "/api/v1/services/aigc/text-generation/generation",
      "headers": {
        "Accept": "text/event-stream",
        "Authorization": "Bearer test-key",
        "Content-Type": "application/json",
        "X-Dashscope-Sse": "enable"
      },
      "body": {
        "model": "qwen3-max",
        "input": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "你好",
                  "cache_control": { "type": "ephemeral" }
                }
              ]
            }
          ]
        },
        "parameters": {
          "result_format": "message",
          "incremental_output": true,
          "max_completion_tokens": 64,
          "enable_thinking": false
        }
      }
    }
  ],
  "sse_response": [
    "data: {\"request_id\":\"req-1\",\"output\":{\"choices\":[{\"finish_reason\":null,\"message\":{\"role\":\"assistant\",\"content\":\"你好\",\"reasoning_content\":\"\"}}]},\"usage\":null}",
    "",
    "data: {\"request_id\":\"req-1\",\"output\":{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"\"}}]},\"usage\":{\"input_tokens\":22,\"output_tokens\":3,\"total_tokens\":25}}",
    ""
  ]
}
