{
  "scenario": "lkeap_thinking_chat",
  "behavior": [
    "lkeapProvider.Matches(deepseek-v3.1)",
    "thinkingTypeField: thinking.type=enabled, custom body forces raw HTTP",
    "completion budget on max_tokens (lkeap wire field)",
    "Bearer auth on raw path"
  ],
  "requests": [
    {
      "path": "/chat/completions",
      "headers": {
        "Authorization": "Bearer test-key",
        "Content-Type": "application/json"
      },
      "body": {
        "model": "deepseek-v3.1",
        "messages": [
          {
            "role": "user",
            "content": "Hi"
          }
        ],
        "max_tokens": 128,
        "thinking": {
          "type": "enabled"
        }
      }
    }
  ],
  "response": {
    "id": "chatcmpl-1",
    "object": "chat.completion",
    "created": 1700000000,
    "model": "golden-model",
    "choices": [
      {
        "index": 0,
        "message": {
          "role": "assistant",
          "content": "Hello there"
        },
        "finish_reason": "stop"
      }
    ],
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 5,
      "total_tokens": 15
    }
  },
  "client": {
    "content": "Hello there",
    "finish_reason": "stop",
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 5,
      "total_tokens": 15,
      "cache_reported": false,
      "cache_status": "unsupported"
    }
  }
}
