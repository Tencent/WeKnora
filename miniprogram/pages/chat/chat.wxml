<view class="page">
  <view class="card">
    <view class="title">{{chatTitle}}</view>
    <view class="muted">{{chatSubtitle}}</view>

    <view class="field">
      <text class="label">{{questionLabel}}</text>
      <textarea value="{{query}}" placeholder="{{questionPlaceholder}}" bindinput="onQueryInput" />
    </view>

    <button bindtap="ask" loading="{{loading}}" disabled="{{!query}}">{{askText}}</button>
  </view>

  <view class="card answer-card" wx:if="{{displayAnswer}}">
    <view class="label">{{answerLabel}}</view>
    <view class="answer">{{displayAnswer}}</view>
  </view>
</view>
