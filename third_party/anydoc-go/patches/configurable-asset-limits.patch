-//! Fixed safety limits, applied identically to every conversion.
+//! Conversion resource limits.
 //!
 //! These are hard caps against attack/abuse input shapes (decompression
 //! bombs, pathological nesting, runaway expansion) - crossing one returns
 //! [`ConvertError::ResourceLimit`](crate::ConvertError::ResourceLimit),
-//! always. They are deliberately not configurable: real-world documents sit
-//! orders of magnitude below every value here.
+//! always. The two asset-related limits allow bounded process configuration.
+
+use std::sync::OnceLock;

 /// Maximum decompressed size of a single archive entry: 128 MiB.
 pub const MAX_ENTRY_BYTES: u64 = 128 * 1024 * 1024;
@@ -42,3 +43,43 @@

 /// Maximum total binary records visited in one legacy record stream.
 pub const MAX_RECORDS: u64 = 16_000_000;
+
+const MAX_CONFIGURED_BYTES: u64 = 256 * 1024 * 1024;
+
+pub fn max_entry_bytes() -> u64 {
+    static LIMIT: OnceLock<u64> = OnceLock::new();
+    *LIMIT.get_or_init(|| configured_limit("ANYDOC_MAX_ENTRY_BYTES", MAX_ENTRY_BYTES))
+}
+
+pub fn max_asset_total_bytes() -> usize {
+    static LIMIT: OnceLock<u64> = OnceLock::new();
+    *LIMIT.get_or_init(|| configured_limit("ANYDOC_MAX_ASSET_TOTAL_BYTES", MAX_ASSET_TOTAL_BYTES as u64))
+        as usize
+}
+
+fn configured_limit(name: &str, default: u64) -> u64 {
+    parse_limit(std::env::var(name).ok().as_deref(), default)
+}
+
+fn parse_limit(value: Option<&str>, default: u64) -> u64 {
+    value
+        .and_then(|value| value.parse::<u64>().ok())
+        .filter(|limit| (1..=MAX_CONFIGURED_BYTES).contains(limit))
+        .unwrap_or(default)
+}
+
+#[cfg(test)]
+mod configured_limit_tests {
+    use super::*;
+
+    #[test]
+    fn accepts_explicit_limits_without_disabling_the_cap() {
+        let default = MAX_ENTRY_BYTES;
+        assert_eq!(parse_limit(Some("167772160"), default), 160 * 1024 * 1024);
+        assert_eq!(parse_limit(Some("1"), default), 1);
+        assert_eq!(parse_limit(Some("268435456"), default), MAX_CONFIGURED_BYTES);
+        for invalid in [None, Some("0"), Some("-1"), Some("128 MiB"), Some("268435457")] {
+            assert_eq!(parse_limit(invalid, default), default);
+        }
+    }
+}
