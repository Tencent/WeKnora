[Desktop Entry]
Version=1.0
Name=Google Chrome
GenericName=Web Browser
Comment=Open Google Chrome on this session's screen
Exec=/usr/local/bin/wk-chrome %U
StartupNotify=true
Terminal=false
Icon=google-chrome
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml_xml;image/webp;x-scheme-handler/http;x-scheme-handler/https;
