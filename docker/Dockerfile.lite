# Fast Production Runtime matching Ubuntu 24.04 (runs binary compiled on ubuntu-latest)
FROM ubuntu:24.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    curl \
    fuse \
    libsqlite3-0 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy DuckDB extensions
COPY .duckdb /root/.duckdb

# Copy gojieba dictionary files required at runtime by gojieba.NewJieba()
# (Copy to both /home/runner/go/... and /go/... to satisfy build-time path embedded by CGO)
RUN mkdir -p /home/runner/go/pkg/mod/github.com/yanyiwu /go/pkg/mod/github.com/yanyiwu
COPY yanyiwu /home/runner/go/pkg/mod/github.com/yanyiwu
COPY yanyiwu /go/pkg/mod/github.com/yanyiwu

# Copy pre-compiled Go binary
COPY weknora /app/weknora

# Copy config, migrations and scripts
COPY config ./config
COPY migrations ./migrations
COPY scripts ./scripts

# Copy pre-built frontend static assets (served by Go backend on /app/web)
COPY frontend/dist /app/web

# Create data directory for GCS FUSE mount
RUN mkdir -p /data/files && chmod 777 /data/files

ENV PORT=8080
ENV STORAGE_TYPE=local
ENV LOCAL_STORAGE_BASE_DIR=/data/files

EXPOSE 8080

ENTRYPOINT ["/app/weknora"]
