# Fast Production Runtime (expects pre-built binary in ./weknora and dist in ./frontend/dist)
FROM debian:12-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    curl \
    fuse \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy DuckDB extensions
COPY .duckdb /root/.duckdb

# Copy gojieba dictionary files required at runtime by gojieba.NewJieba()
COPY yanyiwu /go/pkg/mod/github.com/yanyiwu

# Copy pre-compiled Go binary
COPY weknora /app/weknora

# Copy config, migrations and scripts
COPY config ./config
COPY migrations ./migrations
COPY scripts ./scripts

# Copy pre-built frontend static assets (served by Go backend on /app/web)
COPY frontend/dist /app/web

# Create data directory for GCS FUSE mount
RUN mkdir -p /data/files && chmod 777 /data/files

ENV PORT=8080
ENV STORAGE_TYPE=local
ENV LOCAL_STORAGE_BASE_DIR=/data/files

EXPOSE 8080

ENTRYPOINT ["/app/weknora"]
