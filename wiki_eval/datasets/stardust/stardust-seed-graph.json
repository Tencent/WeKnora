  "generation_rules": {
    "document_strategy": [
      "Start from the seed graph and generate relation-dense wiki pages rather than isolated prose.",
      "Keep each core entity in at least one page and at least one cross-reference path.",
      "Ensure every update event has a before-page and an after-page.",
      "Reserve delete targets for pages that are cited by multiple downstream pages."
    ],
    "qa_strategy": [
      "Mix single-hop, two-hop, and three-hop questions.",
      "Add at least one provenance question per major relation cluster.",
      "Add one contradiction-resolution question for each update event.",
      "Add one delete-regression check for each retract target."
    ],
    "quality_controls": [
      "No orphan core entity.",
      "No update event without a corresponding old-fact removal rule.",
      "No delete event without explicit must-remove and must-keep expectations.",
      "At least two aliases for the most important entities."
    ]
  }
}
