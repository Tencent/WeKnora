+// @vitest-environment node
+import { describe, expect, it } from "vitest";
+import { captureVomObservation } from "@/tools/observation";
+import { type CdpDebuggerApi, ChromiumCdp } from "../chromium-cdp";
+
+describe.skipIf(!process.env.BSK_GEOMETRY_CHROME)("real background task rendering", () => {
+  it.each([
+    0, 2000,
+  ])("renders a background page with %i repeated controls and restores visibility on detach", async (controlCount) => {
+    // Raw CDP deliberately avoids Playwright, which enables focus emulation by default
+    // and would mask this exact regression even when a Chrome tab is inactive.
+    const { withChrome } = await import(
+      new URL(
+        "../../../../../evals/browser/cases/regression/snapshot-coordinates/chrome.mjs",
+        import.meta.url,
+      ).href
+    );
+    await withChrome(
+      { executable: process.env.BSK_GEOMETRY_CHROME, deviceScale: 1, zoom: 1 },
+      async (send: any) => {
+        const foreground = (await send("Target.getTargets")).targetInfos.find(
+          (t: any) => t.type === "page",
+        );
+        const { sessionId: foregroundSession } = await send("Target.attachToTarget", {
+          targetId: foreground.targetId,
+          flatten: true,
+        });
+        const url =
+          "data:text/html," +
+          encodeURIComponent(
+            '<title>Background task</title><p>Loading</p><script>requestAnimationFrame(()=>document.querySelector("p").textContent="Rendered")</script>' +
+              "<section><h2>Entry</h2><button>Open</button><p>Sample page content</p></section>".repeat(
+                controlCount,
+              ),
+          );
+        const { targetId } = await send("Target.createTarget", { url, background: true });
+        let sessionId = (await send("Target.attachToTarget", { targetId, flatten: true }))
+          .sessionId;
+        const evaluate = async (expression: string, session = sessionId) =>
+          (
+            await send(
+              "Runtime.evaluate",
+              { expression, awaitPromise: true, returnByValue: true },
+              session,
+            )
+          ).result.value;
+        // A newly created target may still expose the initial complete about:blank.
+        await expect.poll(() => evaluate("document.title")).toBe("Background task");
+        await expect.poll(() => evaluate("document.readyState")).toBe("complete");
+        expect(
+          await evaluate(
+            '({visibility:document.visibilityState,text:document.querySelector("p").textContent})',
+          ),
+        ).toEqual({ visibility: "hidden", text: "Loading" });
+        await send("Target.detachFromTarget", { sessionId });
+        const event = { addListener() {}, removeListener() {} };
+        const api = {
+          attach: async () => {
+            sessionId = (await send("Target.attachToTarget", { targetId, flatten: true }))
+              .sessionId;
+          },
+          detach: async () => {
+            await send("Target.detachFromTarget", { sessionId });
+          },
+          sendCommand: (_target: unknown, method: string, params: object) =>
+            send(method, params, sessionId),
+          onEvent: event,
+          onDetach: event,
+        } as unknown as CdpDebuggerApi;
+        const cdp = new ChromiumCdp(api);
+        try {
+          await cdp.acquireBackgroundExecution("task", 4);
+          expect(
+            await evaluate(
+              'new Promise(resolve=>requestAnimationFrame(()=>resolve(document.querySelector("p").textContent)))',
+            ),
+          ).toBe("Rendered");
+          const observation = await captureVomObservation(cdp, 4, url);
+          expect(observation.text).toContain("Rendered");
+          expect(observation.refs).toHaveLength(controlCount);
+          const image = await cdp.send<{ data: string }>(4, "Page.captureScreenshot", {
+            format: "jpeg",
+            fromSurface: true,
+          });
+          expect(image.data.length).toBeGreaterThan(100);
+          expect(await evaluate("document.visibilityState", foregroundSession)).toBe("visible");
+          await cdp.releaseSessionTab("task", 4);
+          sessionId = (await send("Target.attachToTarget", { targetId, flatten: true })).sessionId;
+          expect(await evaluate("document.visibilityState")).toBe("hidden");
+        } finally {
+          cdp.dispose();
+        }
+      },
+    );
+  }, 20_000);
+});
