+    query.mockImplementationOnce(async () => {
+      controller.abort();
+      return [...state.tabs.values()];
+    });
+    expect(await close(controller.signal)).toMatchObject({ code: "cancelled" });
+    expect(spies.create).not.toHaveBeenCalled();
+    expect(spies.remove).not.toHaveBeenCalled();
+  });
+
+  it("cleans the replacement and preserves the original on interruption during creation", async () => {
+    const { ctx, state, spies, claimed, close } = await remoteCloseFixture();
