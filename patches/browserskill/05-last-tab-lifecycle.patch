+    expect(await close()).toEqual({ tab_id: 5 });
+    expect(spies.create).not.toHaveBeenCalled();
+    expect([...state.tabs.keys()]).toEqual([6]);
+    expect(ctx.agentCreatedTabs.has(6)).toBe(false);
+  });
