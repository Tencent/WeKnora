+      const tab = { id: 50, windowId: 100 } as chrome.tabs.Tab;
+      state.tabs.set(50, tab);
+      controller.abort();
+      return tab;
+    });
+    expect(await close(controller.signal)).toMatchObject({ code: "cancelled" });
+    expect([...state.tabs.keys()]).toEqual([5]);
+    expect([...ctx.agentCreatedTabs]).toEqual([5]);
+    expect(claimed).not.toHaveBeenCalled();
+    expect(spies.remove).toHaveBeenCalledExactlyOnceWith(50);
+  });
+
+  it.each([
+    false,
+    true,
+  ])("handles failed close with failed placeholder cleanup=%s", async (cleanupFails) => {
+    const { ctx, state, spies, close } = await remoteCloseFixture();
+    spies.remove.mockRejectedValueOnce(new Error("cannot close"));
+    if (cleanupFails) spies.remove.mockRejectedValueOnce(new Error("cannot clean up"));
+    expect(await close()).toMatchObject({ code: "protocol_error", message: "cannot close" });
+    expect([...state.tabs.keys()]).toEqual(cleanupFails ? [5, 50] : [5]);
+    expect([...ctx.agentCreatedTabs]).toEqual(cleanupFails ? [5, 50] : [5]);
+  });
