index 0000000..91bc85a
--- /dev/null
+++ b/apps/extension/src/lib/task-activity.ts
@@ -0,0 +1,86 @@
+import type { SessionManager } from "@/session-manager/manager";
+
+interface Activity {
+  idle: boolean;
+  pending: Set<Promise<unknown>>;
+  releasing?: Promise<void>;
+}
+
+/** Coordinates UI captures with turn-end release and native session stop.
+ * State follows the session object, so deleted sessions cannot retain frames or fences. */
+export class TaskActivity {
+  private readonly states = new WeakMap<object, Activity>();
+  constructor(
+    private readonly manager: SessionManager,
+    private readonly detach: (sessionId: string) => Promise<void>,
+  ) {}
+
+  private state(sessionId: string): Activity | undefined {
+    const task = this.manager.get(sessionId);
+    if (!task?.remote) return undefined;
+    let state = this.states.get(task);
+    if (!state) {
+      state = { idle: false, pending: new Set() };
+      this.states.set(task, state);
+    }
+    return state;
+  }
+
+  private track<T>(state: Activity, run: () => Promise<T>): Promise<T> {
+    const work = Promise.resolve().then(run);
+    state.pending.add(work);
+    void work.then(
+      () => state.pending.delete(work),
+      () => state.pending.delete(work),
+    );
+    return work;
+  }
+
+  preview<T>(sessionId: string, run: () => Promise<T>): Promise<T> {
+    const state = this.state(sessionId);
+    if (!state || state.idle) return Promise.reject(new Error("Task preview is idle"));
+    return this.track(state, run);
+  }
+
+  async run<T>(
+    sessionId: string | undefined,
+    stopping: boolean,
+    run: () => Promise<T>,
+  ): Promise<T> {
+    if (!sessionId) return run();
+    const task = this.manager.get(sessionId);
+    const state = this.state(sessionId);
+    if (!state) return run();
+    if (stopping) {
+      await this.release(sessionId);
+      return run();
+    }
+    if (state.releasing) await state.releasing;
+    if (this.manager.get(sessionId) !== task) throw new Error("Task ended before operation");
+    state.idle = false;
+    return this.track(state, run);
+  }
+
+  release(sessionId: string): Promise<void> {
+    const state = this.state(sessionId);
+    if (!state) return Promise.resolve();
+    if (state.releasing) return state.releasing;
+    state.idle = true;
+    const work = (async () => {
+      // A screenshot's send() can auto-attach. Let every in-flight operation
+      // finish before detaching, and reject new previews throughout release.
+      await Promise.allSettled([...state.pending]);
+      await this.detach(sessionId);
+    })();
+    state.releasing = work;
+    void work.then(
+      () => {
+        state.releasing = undefined;
+      },
+      () => {
+        state.releasing = undefined;
+      },
+    );
+    return work;
+  }
+}
diff --git a/apps/extension/src/lib/task-preview.ts b/apps/extension/src/lib/task-preview.ts
