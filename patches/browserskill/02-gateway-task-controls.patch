@@ -0,0 +1,51 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { attachGatewayUI } from "../gateway-ui";
+
+afterEach(() => vi.unstubAllGlobals());
+function fixture() {
+  vi.stubGlobal("WebSocket", { OPEN: 1 });
+  const socket = Object.assign(new EventTarget(), { readyState: 1, send: vi.fn() });
+  const ui = {
+    focus: vi.fn(async () => ({ focused: true })),
+    preview: vi.fn(async () => ({ image_base64: "jpeg" })),
+  };
+  attachGatewayUI(socket as unknown as WebSocket, ui);
+  const native = vi.fn();
+  socket.addEventListener("message", native);
+  const request = async (body: unknown) => {
+    socket.dispatchEvent(new MessageEvent("message", { data: JSON.stringify(body) }));
+    await new Promise((resolve) => setTimeout(resolve, 0));
+  };
+  return { socket, ui, native, request };
+}
+describe("gateway UI side channel", () => {
+  it("routes UI requests independently and leaves native RPC untouched", async () => {
+    const f = fixture();
+    for (const name of ["preview", "focus"] as const) {
+      await f.request({ id: name, method: `gateway.task_${name}`, params: { session_id: "task" } });
+      expect(f.ui[name]).toHaveBeenCalledWith("task");
+    }
+    expect(f.native).not.toHaveBeenCalled();
+    await f.request({ id: "native", method: "tool.snapshot", params: {} });
+    expect(f.native).toHaveBeenCalledOnce();
+  });
+  it("rejects invalid session IDs without invoking browser work", async () => {
+    const f = fixture();
+    await f.request({ id: "bad", method: "gateway.task_focus", params: { session_id: 42 } });
+    expect(f.ui.focus).not.toHaveBeenCalled();
+    expect(JSON.parse(f.socket.send.mock.calls[0]![0])).toMatchObject({
+      error: { code: "invalid_params" },
+    });
+  });
+  it("reports failures and drops late replies on closed sockets", async () => {
+    const f = fixture();
+    f.ui.focus.mockRejectedValueOnce(new Error("unavailable"));
+    await f.request({ id: "focus", method: "gateway.task_focus", params: { session_id: "task" } });
+    expect(JSON.parse(f.socket.send.mock.calls[0]![0])).toMatchObject({
+      error: { code: "task_unavailable" },
+    });
+    f.socket.readyState = 3;
+    await f.request({ id: "late", method: "gateway.task_preview", params: { session_id: "task" } });
+    expect(f.socket.send).toHaveBeenCalledTimes(1);
+  });
+});
