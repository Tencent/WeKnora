index 0000000..7eae50f
--- /dev/null
+++ b/apps/extension/src/lib/__tests__/task-activity.test.ts
@@ -0,0 +1,93 @@
+import { describe, expect, it, vi } from "vitest";
+import type { SessionManager } from "@/session-manager/manager";
+import { TaskActivity } from "../task-activity";
+
+function deferred() {
+  let resolve!: () => void;
+  const promise = new Promise<void>((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+}
+function fixture() {
+  const tasks = new Map<string, object>([
+    ["one", { remote: true }],
+    ["two", { remote: true }],
+  ]);
+  const manager = { get: (id: string) => tasks.get(id) } as unknown as SessionManager;
+  const detach = vi.fn(async (_id: string) => {});
+  return { tasks, detach, activity: new TaskActivity(manager, detach) };
+}
+describe("task debugging lifecycle", () => {
+  it("drains an in-flight screenshot before detach and rejects later preview attachment", async () => {
+    const { activity, detach, tasks } = fixture();
+    const shot = deferred();
+    const capture = activity.preview("one", () => shot.promise);
+    const release = activity.release("one");
+    await expect(activity.preview("one", async () => {})).rejects.toThrow("idle");
+    await Promise.resolve();
+    expect(detach).not.toHaveBeenCalled();
+    shot.resolve();
+    await Promise.all([capture, release]);
+    expect(detach).toHaveBeenCalledWith("one");
+    expect(tasks.has("one")).toBe(true);
+    await expect(activity.preview("one", async () => {})).rejects.toThrow("idle");
+  });
+  it("waits for automation even if turn end arrives before the operation begins", async () => {
+    const { activity, detach } = fixture();
+    const op = deferred();
+    const running = activity.run("one", false, () => op.promise);
+    const release = activity.release("one");
+    await Promise.resolve();
+    expect(detach).not.toHaveBeenCalled();
+    op.resolve();
+    await Promise.all([running, release]);
+    expect(detach).toHaveBeenCalledTimes(1);
+  });
+  it("a new turn waits for detach then resumes capture without deleting tabs", async () => {
+    const { activity, detach } = fixture();
+    const gate = deferred();
+    detach.mockImplementationOnce(() => gate.promise);
+    const release = activity.release("one");
+    const op = vi.fn(async () => {});
+    const next = activity.run("one", false, op);
+    await Promise.resolve();
+    expect(op).not.toHaveBeenCalled();
+    gate.resolve();
+    await Promise.all([release, next]);
+    expect(op).toHaveBeenCalledOnce();
+    await expect(activity.preview("one", async () => "frame")).resolves.toBe("frame");
+  });
+  it("stop fences previews before closing tabs", async () => {
+    const { activity, detach } = fixture();
+    await activity.run("one", true, async () => {
+      expect(detach).toHaveBeenCalledWith("one");
+      await expect(activity.preview("one", async () => {})).rejects.toThrow("idle");
+    });
+    await expect(activity.preview("one", async () => {})).rejects.toThrow("idle");
+  });
+  it("failed captures do not prevent release or interfere with another task", async () => {
+    const { activity, detach } = fixture();
+    const capture = activity.preview("one", async () => {
+      throw new Error("failed capture");
+    });
+    const release = activity.release("one");
+    await expect(capture).rejects.toThrow("failed capture");
+    await release;
+    await expect(activity.preview("two", async () => "live")).resolves.toBe("live");
+    expect(detach).toHaveBeenCalledTimes(1);
+  });
+  it("does not resume a deleted session after waiting for release", async () => {
+    const { activity, tasks, detach } = fixture();
+    const gate = deferred();
+    detach.mockImplementationOnce(() => gate.promise);
+    const release = activity.release("one");
+    const op = vi.fn(async () => {});
+    const next = activity.run("one", false, op);
+    tasks.delete("one");
+    gate.resolve();
+    await release;
+    await expect(next).rejects.toThrow("Task ended");
+    expect(op).not.toHaveBeenCalled();
+  });
+});
