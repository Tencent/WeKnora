diff --git a/apps/extension/src/session-manager/__tests__/task-popups.test.ts b/apps/extension/src/session-manager/__tests__/task-popups.test.ts
new file mode 100644
index 0000000..f859bdc
--- /dev/null
+++ b/apps/extension/src/session-manager/__tests__/task-popups.test.ts
@@ -0,0 +1,79 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { SessionManager } from "../manager";
+import { withTaskPopups } from "../task-popups";
+
+afterEach(() => vi.unstubAllGlobals());
+async function fixture() {
+  let next = 10;
+  const manager = new SessionManager({
+    remote: () => true,
+    agentWindow: {
+      create: async () => next++,
+      remove: vi.fn(async () => {}),
+      ensureActiveTab: async (id) => id,
+    },
+  });
+  const task = await manager.start("one");
+  const other = await manager.start("two");
+  const tabs = new Map<number, { id: number; windowId: number; active?: boolean }>([
+    [10, { id: 10, windowId: 10, active: true }],
+    [11, { id: 11, windowId: 11, active: true }],
+  ]);
+  const listeners = new Set<(event: { sourceTabId: number; tabId: number }) => void>();
+  const move = vi.fn(async (id: number, props: { windowId: number }) =>
+    Object.assign(tabs.get(id)!, props),
+  );
+  vi.stubGlobal("chrome", {
+    tabs: { query: async () => [tabs.get(10)], get: async (id: number) => tabs.get(id), move },
+    webNavigation: {
+      onCreatedNavigationTarget: {
+        addListener: (fn: (event: { sourceTabId: number; tabId: number }) => void) =>
+          listeners.add(fn),
+        removeListener: (fn: (event: { sourceTabId: number; tabId: number }) => void) =>
+          listeners.delete(fn),
+      },
+    },
+  });
+  const create = (sourceTabId: number, tabId: number, windowId = 10) => {
+    tabs.set(tabId, { id: tabId, windowId });
+    for (const fn of listeners) fn({ sourceTabId, tabId });
+  };
+  return { manager, task, other, tabs, listeners, create, move };
+}
+describe("action-scoped popup ownership", () => {
+  it("claims noopener/nested targets and moves a popup window into its task", async () => {
+    const f = await fixture();
+    await withTaskPopups(f.manager, { session_id: "one" }, async () => {
+      f.create(10, 20);
+      f.create(20, 21, 200);
+      f.create(11, 22); // Another task's source.
+      f.tabs.set(23, { id: 23, windowId: 10 }); // User-created/moved tab, no navigation event.
+    });
+    expect(f.task.agentCreatedTabs).toEqual(new Set([10, 20, 21]));
+    expect(f.move).toHaveBeenCalledWith(21, { windowId: 10, index: -1 });
+    expect(f.listeners.size).toBe(0);
+    f.create(10, 24); // Outside an agent action.
+    expect(f.task.agentCreatedTabs.has(24)).toBe(false);
+  });
+  it("cannot take a tab from another task or use an unauthorized source", async () => {
+    const f = await fixture();
+    await withTaskPopups(f.manager, { session_id: "one", tab_id: 11 }, async () =>
+      f.create(11, 30),
+    );
+    await withTaskPopups(f.manager, { session_id: "one" }, async () => f.create(10, 11, 11));
+    expect(f.task.agentCreatedTabs).toEqual(new Set([10]));
+    expect(f.other.agentCreatedTabs).toEqual(new Set([11]));
+  });
+  it("cleans listeners on failure and rejects targets after source authorization ends", async () => {
+    const f = await fixture();
+    await expect(
+      withTaskPopups(f.manager, { session_id: "one" }, async () => {
+        f.task.agentCreatedTabs.delete(10);
+        f.create(10, 20);
+        throw new Error("input failed");
+      }),
+    ).rejects.toThrow("input failed");
+    expect(f.task.agentCreatedTabs.size).toBe(0);
+    expect(f.listeners.size).toBe(0);
+  });
+});
diff --git a/apps/extension/src/session-manager/task-popups.ts b/apps/extension/src/session-manager/task-popups.ts
new file mode 100644
index 0000000..53db1bf
--- /dev/null
+++ b/apps/extension/src/session-manager/task-popups.ts
@@ -0,0 +1,72 @@
+import { isAgentControlledTab, type SessionManager } from "./manager";
+
+/** Attribute only Chrome-reported navigation targets created during an agent
+ * action on an owned source. Window membership and openerTabId are insufficient.
+ * Delayed/unattributed popups can still use the ordinary consent-based borrow. */
+export async function withTaskPopups<T>(
+  manager: SessionManager,
+  params: { session_id?: string; tab_id?: number },
+  run: () => Promise<T>,
+  onClaimed?: (tabId: number, windowId: number) => void,
+): Promise<T> {
+  const task = params.session_id ? manager.get(params.session_id) : null;
+  const events = globalThis.chrome?.webNavigation?.onCreatedNavigationTarget;
+  if (!task?.remote || !events) return run();
+  const source =
+    params.tab_id ??
+    (
+      await chrome.tabs.query({
+        windowId: task.agentWindowId,
+        active: true,
+      })
+    )[0]?.id;
+  if (source === undefined || !isAgentControlledTab(task, source)) return run();
+  const sources = new Set([source]);
+  const pending = new Set<Promise<void>>();
+  const live = () => manager.get(task.sessionId) === task && !manager.isWindowCloseExpected(task);
+  const created = ({ sourceTabId, tabId }: { sourceTabId: number; tabId: number }) => {
+    if (
+      !live() ||
+      !sources.has(sourceTabId) ||
+      !isAgentControlledTab(task, sourceTabId) ||
+      manager.list().some((other) => isAgentControlledTab(other, tabId))
+    )
+      return;
+    // Record ownership synchronously so a nested popup and cleanup see it.
+    task.agentCreatedTabs.add(tabId);
+    sources.add(tabId);
+    const work = (async () => {
+      try {
+        let tab = await chrome.tabs.get(tabId);
+        if (!live() || !isAgentControlledTab(task, tabId)) return;
+        const other = manager.findByWindowId(tab.windowId);
+        if (other && other !== task) {
+          task.agentCreatedTabs.delete(tabId);
+          sources.delete(tabId);
+          return;
+        }
+        if (tab.windowId !== task.agentWindowId) {
+          await chrome.tabs.move(tabId, { windowId: task.agentWindowId, index: -1 });
+          tab = await chrome.tabs.get(tabId);
+        }
+        if (!live() || !isAgentControlledTab(task, tabId)) return;
+        onClaimed?.(tabId, tab.windowId);
+      } catch (error) {
+        // Preserve a live tab's ownership if moving it failed, so stop can clean
+        // it up; Chrome's removal event forgets tabs that have already closed.
+        console.warn("[bsk] task popup setup failed", error);
+      }
+    })();
+    pending.add(work);
+    void work.then(() => pending.delete(work));
+  };
+  events.addListener(created);
+  try {
+    return await run();
+  } finally {
+    // Chrome can deliver this event just after the CDP input acknowledgement.
+    await new Promise((resolve) => setTimeout(resolve, 100));
+    events.removeListener(created);
+    await Promise.all(pending);
+  }
+}
