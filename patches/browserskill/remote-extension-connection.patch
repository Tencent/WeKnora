+  const task = params.session_id ? manager.get(params.session_id) : null;
+  const source = params.tab_id ?? task?.activeTabId;
+  if (
+    !task?.tabMode ||
+    task.stopping ||
+    source === undefined ||
+    !isAgentControlledTab(task, source)
