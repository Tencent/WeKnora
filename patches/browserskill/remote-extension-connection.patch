+export const TASK_WINDOW_KEY = "bsk.remoteTaskWindowEnabled";
+
+/** Read when a new remote task starts; existing tasks keep their original mode. */
+export async function getTaskWindowEnabled(): Promise<boolean> {
+  const stored = await chrome.storage.local.get(TASK_WINDOW_KEY);
+  return stored[TASK_WINDOW_KEY] !== false;
+}
+
+export async function setTaskWindowEnabled(enabled: boolean): Promise<void> {
+  await chrome.storage.local.set({ [TASK_WINDOW_KEY]: enabled });
+}
