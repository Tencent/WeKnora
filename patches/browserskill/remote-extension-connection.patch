+++ b/apps/extension/src/entrypoints/popup/task-window-mode.tsx
@@ -0,0 +1,62 @@
+import { useTranslation } from "@browser-skill/i18n/react";
+import { useEffect, useState } from "react";
+import { getTaskWindowEnabled, setTaskWindowEnabled } from "@/lib/task-window-preference";
+
+export function TaskWindowMode() {
+  const { t } = useTranslation("extension");
+  const [enabled, setEnabled] = useState(true);
+  const [loaded, setLoaded] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState(false);
+  useEffect(() => {
+    let cancelled = false;
+    getTaskWindowEnabled()
+      .then((value) => {
+        if (!cancelled) {
+          setEnabled(value);
+          setLoaded(true);
+        }
+      })
+      .catch(() => {
+        if (!cancelled) setError(true);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+  async function update(value: boolean) {
+    setSaving(true);
+    setError(false);
+    try {
+      await setTaskWindowEnabled(value);
+      setEnabled(value);
+    } catch {
+      setError(true);
+    } finally {
+      setSaving(false);
+    }
+  }
+  return (
+    <section className="rounded-xl border border-border/80 bg-card/60 px-3 py-2.5">
+      <label htmlFor="bsk-task-window-mode" className="text-sm font-medium">
+        {t("popup.taskWindowTitle")}
+      </label>
+      <select
+        id="bsk-task-window-mode"
+        value={enabled ? "window" : "tabs"}
+        disabled={!loaded || saving}
+        onChange={(event) => void update(event.target.value === "window")}
+        className="mt-2 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm"
+      >
+        <option value="window">{t("popup.taskWindowVisible")}</option>
+        <option value="tabs">{t("popup.taskWindowTabs")}</option>
+      </select>
+      <p className="mt-2 text-xs leading-snug text-muted-foreground">{t("popup.taskWindowHint")}</p>
+      {error && (
+        <p role="alert" className="mt-2 text-xs text-destructive">
+          {t("popup.taskWindowError")}
+        </p>
+      )}
+    </section>
+  );
+}
