+import { isAgentControlledTab, type SessionManager } from "./manager";
+
+/** Track page-created tabs only while dispatching input to a known task tab.
+ * Group membership and tabs.onCreated alone are never ownership evidence.
+ * webNavigation also supplies sourceTabId for rel=noopener links.
+ */
+export async function withTaskPopups<T>(
+  manager: SessionManager,
+  params: { session_id?: string; tab_id?: number },
+  run: () => Promise<T>,
+  onClaimed?: (tabId: number, windowId: number) => void,
