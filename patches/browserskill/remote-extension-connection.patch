+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { SessionManager } from "../manager";
+import { withTaskPopups } from "../task-popups";
+
+describe("page-created task tabs", () => {
+  let manager: SessionManager;
+  let tabs: Map<number, any>;
+  let listeners: Set<(event: { sourceTabId: number; tabId: number }) => void>;
+  let api: any;
+  let activations: Set<(event: { tabId: number }) => void>;
+  beforeEach(() => {
+    listeners = new Set();
+    activations = new Set();
+    tabs = new Map([
+      [1, { id: 1, windowId: 10, active: true }],
+      [2, { id: 2, windowId: 10, active: false }],
+    ]);
+    let id = 10;
+    api = {
+      onActivated: {
+        addListener: (fn: any) => activations.add(fn),
+        removeListener: (fn: any) => activations.delete(fn),
+      },
+      query: vi.fn(async () => [...tabs.values()].filter((t) => t.active)),
+      get: vi.fn(async (id: number) => {
+        if (!tabs.has(id)) throw new Error("closed");
+        return tabs.get(id);
+      }),
+      create: vi.fn(async (props: any) => {
+        const tab = { id: ++id, ...props };
+        tabs.set(tab.id, tab);
+        return tab;
+      }),
+      update: vi.fn(async (id: number, props: any) => {
+        if (props.active) for (const tab of tabs.values()) tab.active = false;
+        return Object.assign(tabs.get(id), props);
+      }),
+      group: vi.fn(async () => 7),
+      ungroup: vi.fn(async (id: number) => { tabs.get(id).groupId = -1; }),
+      move: vi.fn(async (id: number, props: any) => Object.assign(tabs.get(id), props)),
+      remove: vi.fn(async (id: number) => {
+        tabs.delete(id);
+        manager.forgetClosedTab(id);
+      }),
+    };
+    vi.stubGlobal("chrome", {
+      tabs: api,
+      tabGroups: { update: vi.fn() },
+      windows: { getAll: vi.fn(async () => [{ id: 10, focused: true }]), remove: vi.fn() },
+      webNavigation: {
+        onCreatedNavigationTarget: {
+          addListener: (fn: any) => listeners.add(fn),
+          removeListener: (fn: any) => listeners.delete(fn),
+        },
+      },
+    });
+    manager = new SessionManager({ taskTabs: () => true });
+  });
+  afterEach(() => vi.unstubAllGlobals());
+  const notify = (sourceTabId: number, tabId: number) => {
+    for (const fn of listeners) fn({ sourceTabId, tabId });
+  };
+  it("claims noopener and nested popups and closes every owned tab, preserving user and other-task tabs", async () => {
+    const task = await manager.start("one"),
+      other = await manager.start("two");
+    const start = task.activeTabId!;
+    await withTaskPopups(manager, { session_id: task.sessionId }, async () => {
+      // No openerTabId: webNavigation is the authoritative source link.
+      tabs.set(20, { id: 20, windowId: 10, active: true, groupId: 7 });
+      notify(start, 20);
+      tabs.set(21, { id: 21, windowId: 10, active: false });
+      notify(20, 21);
+      // Being dragged into the same group must not grant ownership.
