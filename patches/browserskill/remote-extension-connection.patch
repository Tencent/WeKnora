+// Bound renderer reads, not user-requested waits or mutations. An expired
+// CDP read cannot be cancelled individually; its late reply is ignored and
+// observation must stop rather than issue fallback reads against the same page.
+const READ_COMMANDS = new Set([
+  "Target.setAutoAttach",
+  "DOMSnapshot.enable",
+  "DOMSnapshot.captureSnapshot",
+  "Accessibility.enable",
+  "Accessibility.getFullAXTree",
+  "Page.getLayoutMetrics",
+  "Page.getFrameTree",
+  "DOM.getFrameOwner",
+  "Page.captureScreenshot",
+  "Emulation.setFocusEmulationEnabled",
+]);
+export class CdpReadTimeoutError extends Error {
+  constructor(method: string, tabId: number | undefined, timeout: number) {
+    super(
+      `Browser read ${method} timed out after ${timeout}ms (tab ${tabId}). Do not repeat the same read in a loop; report the timeout and let the browser task release control before retrying.`,
+    );
+    this.name = "CdpReadTimeoutError";
+  }
+}
+
+export async function runCdpCommand<T>(
+  target: CdpDebuggee,
+  method: string,
+  run: () => Promise<T>,
+): Promise<T> {
+  const started = Date.now();
+  const details = () => ({
+    tabId: target.tabId,
+    frameSessionId: target.sessionId,
+    method,
+    elapsedMs: Date.now() - started,
+  });
+  const slow = setTimeout(() => console.warn("[bsk cdp] slow command", details()), 2_000);
+  let deadline: ReturnType<typeof setTimeout> | undefined;
+  let timedOut = false;
+  const settled = (outcome: "returned" | "failed") => {
+    if (Date.now() - started >= 2_000)
+      console.warn("[bsk cdp] slow command settled", { ...details(), outcome, late: timedOut });
+  };
+  try {
+    const pending = run().then(
+      (value) => {
+        settled("returned");
+        return value;
+      },
+      (error) => {
+        settled("failed");
+        throw error;
+      },
+    );
+    if (!READ_COMMANDS.has(method)) return await pending;
+    const timeout = method === "Page.captureScreenshot" ? 3_000 : 10_000;
+    return await Promise.race([
+      pending,
+      new Promise<never>((_, reject) => {
+        deadline = setTimeout(() => {
+          timedOut = true;
+          reject(new CdpReadTimeoutError(method, target.tabId, timeout));
+        }, timeout);
+      }),
+    ]);
+  } catch (error) {
+    console.warn("[bsk cdp] command failed", {
+      ...details(),
+      error: error instanceof Error ? error.message : String(error),
+    });
+    throw error;
+  } finally {
+    clearTimeout(slow);
+    clearTimeout(deadline);
+  }
+}
