+  const [foreground] = await chrome.tabs.query({ active: true, lastFocusedWindow: true });
+  const sources = new Set([source]);
+  const pending = new Set<Promise<void>>();
+  const popups = new Set<number>();
+  const track = (work: Promise<void>) => {
+    pending.add(work);
+    void work.finally(() => pending.delete(work));
+  };
+  const restore = async (tabId: number) => {
+    try {
+      const tab = await chrome.tabs.get(tabId);
+      if (task.taskWindow && tab.windowId === task.agentWindowId) return;
+      if (foreground?.id !== undefined && tab.active)
+        await chrome.tabs.update(foreground.id, { active: true });
+    } catch {
+      /* The popup or previous foreground tab may have closed. */
+    }
+  };
+  const activated = ({ tabId }: { tabId: number }) => {
+    if (popups.has(tabId)) track(restore(tabId));
+  };
+  const created = ({ sourceTabId, tabId }: { sourceTabId: number; tabId: number }) => {
+    if (
+      !sources.has(sourceTabId) ||
+      task.stopping ||
+      manager.get(task.sessionId) !== task ||
+      manager.findByTabId(tabId)
+    )
+      return;
+    // Claim synchronously, before grouping/focus work or a concurrent stop.
+    task.agentCreatedTabs.add(tabId);
+    task.activeTabId = tabId;
+    sources.add(tabId);
+    popups.add(tabId);
+    const work = (async () => {
+      try {
+        let tab = await chrome.tabs.get(tabId);
+        // Chrome activates renderer-created tabs before extension events. Restore
+        // only if that popup still owns focus; never override a later user switch.
+        await restore(tabId);
+        if (task.stopping || manager.get(task.sessionId) !== task) return;
+        if (tab.windowId !== task.agentWindowId) {
+          await chrome.tabs.move(tabId, { windowId: task.agentWindowId, index: -1 });
+          tab = await chrome.tabs.get(tabId);
+        }
+        if (task.taskGroupId !== undefined) {
+          try {
+            await chrome.tabs.group({ tabIds: [tabId], groupId: task.taskGroupId });
+          } catch {
