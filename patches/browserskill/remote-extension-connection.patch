@@ -0,0 +1,55 @@
+import { i18n } from "@browser-skill/i18n";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { getTaskWindowEnabled, TASK_WINDOW_KEY } from "@/lib/task-window-preference";
+import { TaskWindowMode } from "./task-window-mode";
+
+let data: Record<string, unknown>;
+let write: ReturnType<typeof vi.fn>;
+beforeEach(async () => {
+  await i18n.changeLanguage("zh-CN");
+  data = {};
+  write = vi.fn(async (values: object) => {
+    Object.assign(data, values);
+  });
+  vi.stubGlobal("chrome", { storage: { local: { get: async () => ({ ...data }), set: write } } });
+});
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+it("defaults to a separate window and preserves an explicit tab preference across popup remounts", async () => {
+  const view = render(<TaskWindowMode />);
+  const select = screen.getByRole("combobox") as HTMLSelectElement;
+  await waitFor(() => expect(select.disabled).toBe(false));
+  expect(select.value).toBe("window");
+  fireEvent.change(select, { target: { value: "tabs" } });
+  await waitFor(() => expect(select.value).toBe("tabs"));
+  expect(await getTaskWindowEnabled()).toBe(false);
+  expect(write).toHaveBeenCalledWith({ [TASK_WINDOW_KEY]: false });
+  view.unmount();
+  render(<TaskWindowMode />);
+  await waitFor(() =>
+    expect((screen.getByRole("combobox") as HTMLSelectElement).value).toBe("tabs"),
+  );
+});
+it("retains the default mode and exposes a failed write", async () => {
+  render(<TaskWindowMode />);
+  const select = screen.getByRole("combobox") as HTMLSelectElement;
+  await waitFor(() => expect(select.disabled).toBe(false));
+  write.mockRejectedValueOnce(new Error("storage unavailable"));
+  fireEvent.change(select, { target: { value: "tabs" } });
+  await screen.findByRole("alert");
+  expect(select.value).toBe("window");
+  expect(await getTaskWindowEnabled()).toBe(true);
+});
+
+it("loads an explicitly saved separate-window preference", async () => {
+  data[TASK_WINDOW_KEY] = true;
+  render(<TaskWindowMode />);
+  const select = screen.getByRole("combobox") as HTMLSelectElement;
+  await waitFor(() => expect(select.disabled).toBe(false));
+  expect(select.value).toBe("window");
+  expect(await getTaskWindowEnabled()).toBe(true);
+  expect(write).not.toHaveBeenCalled();
+});
