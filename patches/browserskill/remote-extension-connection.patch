+          }
+        }
+        if (task.taskWindow) await chrome.tabs.update(tabId, { active: true });
+        onClaimed?.(tabId, tab.windowId);
+      } catch (error) {
+        // Preserve ownership if Chrome races with cleanup so stop can retry.
+        console.warn("[bsk] task popup setup failed", error);
+      }
+    })();
+    track(work);
+  };
+  chrome.tabs.onActivated.addListener(activated);
+  chrome.webNavigation.onCreatedNavigationTarget.addListener(created);
+  try {
+    return await run();
+  } finally {
+    // Renderer navigation events can follow the CDP input acknowledgement.
+    // Drain that bounded tail before releasing this input's source attribution.
+    await new Promise((resolve) => setTimeout(resolve, 100));
+    chrome.webNavigation.onCreatedNavigationTarget.removeListener(created);
+    while (pending.size) await Promise.all(pending);
+    chrome.tabs.onActivated.removeListener(activated);
+  }
+}
