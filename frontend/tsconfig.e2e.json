{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
