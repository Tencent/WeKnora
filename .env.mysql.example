DB_USER=weknora
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=weknora
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# MySQL stores WeKnora application metadata. Select an existing vector engine
# for retrieval; MySQL is not a replacement for the PostgreSQL pgvector path.
RETRIEVE_DRIVER=qdrant
AUTO_MIGRATE=true
LOG_LEVEL=info
# Optional application file log. Leave empty to write only to container stdout.
LOG_PATH=
LOG_FILE_MAX_SIZE_MB=50
LOG_FILE_MAX_BACKUPS=3
LOG_FILE_MAX_AGE_DAYS=28
LOG_FILE_COMPRESS=true
# Disk space signals for the filesystem containing LOG_PATH.
LOG_DISK_WARNING_FREE_PERCENT=20
LOG_DISK_CRITICAL_FREE_PERCENT=10
LOG_DISK_MIN_FREE_GB=5
# Optional SMTP alerts for deployment operators. Leave disabled until SMTP
# credentials and recipients have been configured.
OPS_ALERT_EMAIL_ENABLED=false
OPS_ALERT_EMAIL_TO=
OPS_ALERT_CHECK_INTERVAL_SECONDS=60
OPS_ALERT_COOLDOWN_SECONDS=300
OPS_ALERT_TIMEOUT_SECONDS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Prefer a Docker secret or host-mounted file over SMTP_PASSWORD.
SMTP_PASSWORD_FILE=
SMTP_FROM=
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
