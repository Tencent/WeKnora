DB_USER=weknora
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=weknora
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# MySQL stores WeKnora application metadata. Select an existing vector engine
# for retrieval; MySQL is not a replacement for the PostgreSQL pgvector path.
RETRIEVE_DRIVER=qdrant
AUTO_MIGRATE=true
LOG_LEVEL=info
# Optional application file log. Leave empty to write only to container stdout.
LOG_PATH=
LOG_FILE_MAX_SIZE_MB=50
LOG_FILE_MAX_BACKUPS=3
LOG_FILE_MAX_AGE_DAYS=28
LOG_FILE_COMPRESS=true
# Disk space signals for the filesystem containing LOG_PATH.
LOG_DISK_WARNING_FREE_PERCENT=20
LOG_DISK_CRITICAL_FREE_PERCENT=10
LOG_DISK_MIN_FREE_GB=5
# Optional SMTP alerts for deployment operators. Leave disabled until SMTP
# credentials and recipients have been configured.
OPS_ALERT_EMAIL_ENABLED=false
OPS_ALERT_EMAIL_TO=
OPS_ALERT_CHECK_INTERVAL_SECONDS=60
OPS_ALERT_COOLDOWN_SECONDS=300
OPS_ALERT_TIMEOUT_SECONDS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Prefer a Docker secret or host-mounted file over SMTP_PASSWORD.
SMTP_PASSWORD_FILE=
SMTP_FROM=
# Manual MySQL logical backups. Set BACKUP_ENABLED=true only after verifying
# that BACKUP_HOST_DIR is an access-controlled host directory on a data disk.
BACKUP_ENABLED=false
BACKUP_LOCAL_DIR=/data/backups
BACKUP_HOST_DIR=D:/WeKnoraBackups
BACKUP_TIMEOUT_SECONDS=900
BACKUP_MYSQLDUMP_PATH=mysqldump
# Optional local-file archive paired with every successful MySQL backup. Enable
# only with STORAGE_TYPE=local; the source must not overlap BACKUP_LOCAL_DIR.
BACKUP_FILES_ENABLED=false
# 定时备份 / scheduled backup. BACKUP_SCHEDULE uses standard five-field Cron
# (minute hour day-of-month month day-of-week) and stays disabled while empty.
# Example: 30 3 * * * runs at 03:30 in the app container timezone.
BACKUP_SCHEDULE=
# 保留策略 / retention. 0 disables automatic deletion; the newest valid backup
# is always retained when cleanup is enabled.
BACKUP_RETENTION_DAYS=7
# 自动备份的最低可用空间 / minimum free space for scheduled backups only.
BACKUP_MIN_FREE_GB=5
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
