DB_USER=weknora
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=weknora
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# MySQL stores WeKnora application metadata. Select an existing vector engine
# for retrieval; MySQL is not a replacement for the PostgreSQL pgvector path.
RETRIEVE_DRIVER=qdrant
AUTO_MIGRATE=true
LOG_LEVEL=info
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
