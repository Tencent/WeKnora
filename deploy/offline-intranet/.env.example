# TreeRAG 内网离线部署 — 环境变量模板（不含真实密钥）
# 复制为 .env 后填写；正式分发包已预置 .env。

WEKNORA_VERSION=v0.8.24
GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN
AUTO_MIGRATE=true
# 启动时若发现 schema_migrations 超前但关键列/表缺失则拒绝启动（默认开启）。
# 紧急拉起可设 SCHEMA_DRIFT_FATAL=false，修复后务必改回。
SCHEMA_DRIFT_FATAL=true
OLLAMA_OPTIONAL=true

FRONTEND_PORT=18080
APP_PORT=18081
APP_HOST=app
APP_BACKEND_PORT=8080
APP_SCHEME=http
APP_EXTERNAL_URL=http://127.0.0.1
FRONTEND_BASE_URL=http://127.0.0.1

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB
DB_NAME=TreeRAG

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_DB=0
REDIS_PREFIX=stream:

STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
MAX_FILE_SIZE_MB=50
RETRIEVE_DRIVER=postgres
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

DISABLE_REGISTRATION=true
JWT_SECRET=CHANGE_ME_JWT_SECRET_LONG_RANDOM
SYSTEM_AES_KEY=weknora-system-aes-key-32bytes!!

GATEWAY_NAME=内蒙古人社AI网关
GATEWAY_BASE_URL=http://10.55.45.50:38080/v1
GATEWAY_API_KEY=CHANGE_ME_GATEWAY_KEY

LLM_MODEL_NAME=Qwen3.6
LLM_BASE_URL=http://10.55.45.50:38080/v1
LLM_API_KEY=CHANGE_ME_GATEWAY_KEY
LLM_PROVIDER=openai

EMBEDDING_MODEL_NAME=bge
EMBEDDING_BASE_URL=http://10.55.45.50:38080/v1
EMBEDDING_API_KEY=CHANGE_ME_GATEWAY_KEY
EMBEDDING_PROVIDER=openai

RERANK_MODEL_NAME=bge-reranker-v2-m3
RERANK_BASE_URL=http://10.55.45.50:38080/v1
RERANK_API_KEY=CHANGE_ME_GATEWAY_KEY
RERANK_PROVIDER=generic

SSRF_WHITELIST=10.55.45.50,10.0.0.0/8
